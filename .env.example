# ---------------------------------------------------------------------------
# JARVIS — Environment Variable Template
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored by default in Next.js — never commit real secrets.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Phase 2 — Prisma + PostgreSQL)
# Local docker-compose default shown below; replace with a hosted Postgres
# connection string when deploying.
DATABASE_URL="postgresql://jarvis:jarvis_dev_password@localhost:5432/jarvis?schema=public"

# Redis (Phase 9 — background jobs / BullMQ)
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Authentication — Phase 3 (Clerk)
# Get these from https://dashboard.clerk.com → your app → API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Clerk Dashboard → Webhooks → Add Endpoint → /api/webhooks/clerk
# Subscribe to: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI Engine — Phase 5+ (Google Gemini)
# FREE tier, no billing required. Get a key in ~30 seconds:
# https://aistudio.google.com/apikey
# Powers: Command Center, Hermes agent, Support Center AI drafts,
# Daily Briefings narrative summaries.
# ---------------------------------------------------------------------------
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# MCP Integrations — Phases 10-12
# All OPTIONAL. Each of these ships as a full mock service layer that works
# with zero configuration — every feature (drafts, scheduling, campaigns,
# subscribers, etc.) runs against realistic local mock data. Setting the
# matching key below switches that module from mock to real automatically
# (see src/lib/<module>/index.ts) — no code changes needed.
# ---------------------------------------------------------------------------
# Phase 10 — Social Media. Requires a PAID Buffer plan (no free-tier API access).
BUFFER_ACCESS_TOKEN=
# Phase 11 — Revenue. Requires a RevenueCat project with products configured.
REVENUECAT_API_KEY=
# Phase 12 — Meta Ads. Requires a Meta Business Manager + ad account + app review.
META_ADS_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Not yet used by any shipped phase (reserved for later phases)
# ---------------------------------------------------------------------------
# Monitoring — Phase 19
SENTRY_DSN=
