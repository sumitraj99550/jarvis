# ---------------------------------------------------------------------------
# JARVIS — Production Environment Template (Phase 20)
# ---------------------------------------------------------------------------
# Copy to `.env.production` and fill in real values. This file is read by
# docker-compose.prod.yml's `env_file` directive AND passed to Postgres for
# its own startup (POSTGRES_PASSWORD, etc).
#
# IMPORTANT: hostnames differ from local dev's .env.local! Inside
# docker-compose.prod.yml's network, the app/worker containers reach
# Postgres/Redis by their Docker Compose SERVICE NAME ("postgres",
# "redis"), not "localhost" — Docker Compose provides DNS resolution for
# service names automatically on its internal network.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=https://your-domain.com

# Postgres — used both by the postgres container itself and by DATABASE_URL
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=CHANGE_ME_TO_A_REAL_SECRET
POSTGRES_DB=jarvis
DATABASE_URL="postgresql://jarvis:CHANGE_ME_TO_A_REAL_SECRET@postgres:5432/jarvis?schema=public"

# Redis — note the "redis" hostname (Docker service name), not "localhost"
REDIS_URL="redis://redis:6379"

# ---------------------------------------------------------------------------
# Clerk — use your PRODUCTION Clerk instance keys (pk_live_ / sk_live_),
# not the pk_test_ / sk_test_ keys from local development.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Point this webhook at https://your-domain.com/api/webhooks/clerk in the
# Clerk Dashboard once deployed, then paste the signing secret here.
CLERK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI Engine (Phase 5+) — same free Gemini key as local dev works fine here.
# ---------------------------------------------------------------------------
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# MCP Integrations (Phases 10-12) — optional, same as local dev.
# ---------------------------------------------------------------------------
BUFFER_ACCESS_TOKEN=
REVENUECAT_API_KEY=
META_ADS_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Security (Phase 19/20)
# ---------------------------------------------------------------------------
# Enable Content-Security-Policy once you've verified sign-in, chat
# streaming, and voice features all still work against your real domain —
# see next.config.mjs for the exact directives being applied.
ENABLE_CSP=false

SENTRY_DSN=
