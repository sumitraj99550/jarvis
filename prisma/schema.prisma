// JARVIS — Prisma Schema
// ---------------------------------------------------------------------------
// This file is the single source of truth for the database.
//
// Prisma 7 changed how datasource connection details are provided:
//   - Connection URL lives in `prisma.config.ts` (project root), NOT here
//   - This file is purely structural: models, enums, and the provider name
//
// Common commands:
//   npx prisma migrate dev   — generate & apply a new migration
//   npx prisma generate      — regenerate the type-safe client
//   npm run db:seed          — seed local dev data
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  // driverAdapters no longer requires a previewFeature flag in Prisma 7.8+.
  // postgresqlExtensions (Phase 17) is a *different*, still-active preview
  // feature — required to declare `extensions = [vector]` below so
  // `prisma migrate dev` runs `CREATE EXTENSION IF NOT EXISTS vector`.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  // NOTE: `url` is intentionally absent — Prisma 7 reads it from
  // `prisma.config.ts` via `datasource.url`. Adding it here would cause
  // "The datasource property `url` is no longer supported" error.
  //
  // Phase 17: requires the `pgvector/pgvector:pg16` Docker image (NOT
  // plain `postgres:16-alpine`) — see docker-compose.yml. Standard
  // Postgres doesn't ship the vector extension.
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  SUPPORT
  VIEWER
}

model User {
  id      String  @id @default(cuid())
  // clerkId is the stable identifier Clerk assigns every user (format: "user_xxx").
  // It is the primary join key between Clerk's identity layer and our database.
  // Nullable because rows seeded before Phase 3 pre-date Clerk; populated on
  // first sign-in via webhook or getCurrentDbUser() fallback.
  clerkId String? @unique
  email   String  @unique
  name    String?
  role    Role    @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  tasks         Task[]
  auditLogs     AuditLog[]
  socialPosts   SocialPost[]
  socialAccounts SocialAccount[]
  socialSettings SocialSettings?
  revenueSubscribers RevenueSubscriber[]
  revenueSettings    RevenueSettings?
  campaigns          Campaign[]
  adAudiences        AdAudience[]
  metaAdsSettings    MetaAdsSettings?
  assignedTickets    Ticket[]
  knowledgeDocuments KnowledgeDocument[]
  agentMemories      AgentMemory[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// AI Command Center (Phase 5+)
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  response  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("conversations")
}

// ---------------------------------------------------------------------------
// Long-term memory / knowledge base — DEFERRED to Phase 17
// ---------------------------------------------------------------------------
// The MemoryEmbedding model (vector embeddings via pgvector) has been
// intentionally excluded from this phase. Reasons:
//   1. Standard `postgres:16-alpine` (the Docker image in docker-compose.yml)
//      does NOT include the pgvector extension. Attempting to create the
//      `vector` extension causes `prisma migrate dev` to fail with
//      "extension \"vector\" is not available".
//   2. No application code uses embeddings yet — this is a Phase 17 feature.
//
// When Phase 17 lands:
//   - Switch the Docker image to `pgvector/pgvector:pg16`
//   - Re-add `extensions = [vector]` to the datasource block
//   - Add `previewFeatures = ["postgresqlExtensions"]` to the generator
//   - Re-add the MemoryEmbedding model

// ---------------------------------------------------------------------------
// Task management (Phase 18)
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id            String       @id @default(cuid())
  title         String
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  // Free-text agent name (e.g. "hermes", "support-agent").
  // Will be replaced with a proper Agent FK in Phase 7.
  assignedAgent String?
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, status])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Daily Briefing Engine (Phase 14)
// ---------------------------------------------------------------------------

model Briefing {
  id        String   @id @default(cuid())
  /** Calendar date (midnight UTC) this briefing covers. */
  date      DateTime @default(now())
  summary   String   @db.Text
  /** Structured metrics the summary was generated from — powers the UI's stat cards. */
  stats     Json
  createdAt DateTime @default(now())

  @@map("briefings")
}

// ---------------------------------------------------------------------------
// Customer Support Agent (Phase 13)
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  ESCALATED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketMessageAuthor {
  CUSTOMER
  AGENT
  AI_DRAFT
}

model Ticket {
  id            String         @id @default(cuid())
  subject       String
  customer      String
  customerEmail String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(MEDIUM)
  resolution    String?        @db.Text
  assignedToId  String?
  assignedTo    User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, priority])
  @@map("tickets")
}

/** A single message in a ticket's thread — from the customer, an agent, or an AI-drafted reply. */
model TicketMessage {
  id        String              @id @default(cuid())
  ticketId  String
  ticket    Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    TicketMessageAuthor
  content   String              @db.Text
  createdAt DateTime            @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ---------------------------------------------------------------------------
// Meta Ads MCP (Phase 12)
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignObjective {
  AWARENESS
  TRAFFIC
  ENGAGEMENT
  CONVERSIONS
  APP_INSTALLS
}

enum AdPlatform {
  FACEBOOK
  INSTAGRAM
  AUDIENCE_NETWORK
  MESSENGER
}

model Campaign {
  id             String            @id @default(cuid())
  name           String
  status         CampaignStatus    @default(DRAFT)
  objective      CampaignObjective @default(TRAFFIC)
  platform       AdPlatform        @default(FACEBOOK)
  /** Total lifetime budget for the campaign. */
  budgetCents    Int               @default(0)
  dailyBudgetCents Int             @default(0)
  spend          Decimal           @default(0) @db.Decimal(12, 2)
  impressions    Int               @default(0)
  clicks         Int               @default(0)
  /** Meta Marketing API campaign id once created through the (mock) client. */
  providerId     String?
  ownerId        String?
  owner          User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dailyStats     CampaignDailyStat[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([ownerId, status])
  @@map("campaigns")
}

/** Daily performance rollup — powers the Performance tab's trend chart. */
model CampaignDailyStat {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spendCents  Int      @default(0)

  @@unique([campaignId, date])
  @@map("campaign_daily_stats")
}

/** Mock Custom Audience — mirrors Meta's Custom Audiences concept. */
model AdAudience {
  id            String   @id @default(cuid())
  name          String
  description   String?
  sizeEstimate  Int      @default(0)
  providerId    String?
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([ownerId])
  @@map("ad_audiences")
}

model MetaAdsSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayCurrency String  @default("USD")
  /** If true, campaigns auto-pause when spend reaches their budget. */
  autoPauseOnBudget Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("meta_ads_settings")
}

// ---------------------------------------------------------------------------
// Revenue / RevenueCat MCP (Phase 11)
// ---------------------------------------------------------------------------
// STUB PHASE: same architecture as Social/Buffer (Phase 10) — RevenueCat
// requires the user to configure their own app + products before its API
// returns anything meaningful, so this ships against a mock service layer
// (src/lib/revenuecat/) instead. Every feature (subscriber list, product
// catalog, transaction history, granting promotional entitlements, revenue
// overview) works end-to-end locally against seeded mock data. Only the
// final network hop to api.revenuecat.com is mocked.

enum RevenueSubscriptionStatus {
  ACTIVE
  IN_TRIAL
  CANCELLED
  EXPIRED
  BILLING_ISSUE
}

enum RevenueStore {
  APP_STORE
  PLAY_STORE
  STRIPE
  PROMOTIONAL
}

enum RevenueTransactionType {
  PURCHASE
  RENEWAL
  REFUND
  CANCELLATION
  PROMOTIONAL_GRANT
}

enum RevenuePeriod {
  WEEKLY
  MONTHLY
  YEARLY
  LIFETIME
}

model RevenueProduct {
  id          String          @id @default(cuid())
  /** Store product identifier, e.g. "jarvis_pro_monthly" */
  productId   String          @unique
  name        String
  priceCents  Int
  currency    String          @default("USD")
  period      RevenuePeriod
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  subscriptions RevenueSubscription[]
  transactions  RevenueTransaction[]

  @@map("revenue_products")
}

model RevenueSubscriber {
  id           String                 @id @default(cuid())
  /** RevenueCat "app_user_id" — mock-generated, not a real Clerk/app id. */
  appUserId    String                 @unique
  email        String?
  ownerId      String
  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now())
  subscriptions RevenueSubscription[]
  transactions  RevenueTransaction[]

  @@index([ownerId])
  @@map("revenue_subscribers")
}

model RevenueSubscription {
  id               String                    @id @default(cuid())
  subscriberId     String
  subscriber       RevenueSubscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  productId        String
  product          RevenueProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
  status           RevenueSubscriptionStatus @default(ACTIVE)
  store            RevenueStore              @default(APP_STORE)
  startedAt        DateTime                  @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([subscriberId, status])
  @@map("revenue_subscriptions")
}

model RevenueTransaction {
  id           String                 @id @default(cuid())
  subscriberId String
  subscriber   RevenueSubscriber      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  productId    String
  product      RevenueProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         RevenueTransactionType
  amountCents  Int
  currency     String                 @default("USD")
  occurredAt   DateTime               @default(now())

  @@index([subscriberId, occurredAt])
  @@map("revenue_transactions")
}

model RevenueSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayCurrency String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("revenue_settings")
}

// ---------------------------------------------------------------------------
// Long-Term Memory & Knowledge Base (Phase 17)
// ---------------------------------------------------------------------------
// REAL, no mock layer — semantic search runs on Gemini's free embedding
// endpoint (text-embedding-004, 768 dimensions) plus pgvector for cosine
// similarity. Same GOOGLE_AI_API_KEY the rest of the app already uses.
//
// `embedding` is `Unsupported("vector(768)")` because Prisma Client has no
// native vector type — this means Prisma Client's generated create/update
// methods can't set it directly. Writes go through `$executeRaw` and
// similarity search through `$queryRaw` — see src/lib/knowledge/.

model KnowledgeDocument {
  id        String                    @id @default(cuid())
  title     String
  content   String                    @db.Text
  /** Populated asynchronously right after create — null until embedded. */
  embedding Unsupported("vector(768)")?
  ownerId   String
  owner     User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([ownerId])
  @@map("knowledge_documents")
}

/**
 * Long-term agent memory — facts JARVIS is explicitly asked to remember
 * (via the `remember_fact` Hermes tool) or that get saved from a
 * conversation, retrievable by *meaning* (not just keyword) in later
 * sessions via the `recall_memory` tool.
 */
model AgentMemory {
  id        String                    @id @default(cuid())
  content   String                    @db.Text
  embedding Unsupported("vector(768)")?
  ownerId   String
  owner     User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime                  @default(now())

  @@index([ownerId])
  @@map("agent_memories")
}

// ---------------------------------------------------------------------------
// Social Media / Buffer MCP (Phase 10)
// ---------------------------------------------------------------------------
// STUB PHASE: Buffer's API requires a paid Buffer plan (no free tier API
// access), so this phase ships against a mock service layer
// (src/lib/buffer/) instead of the real Buffer API. Every feature —
// connected accounts, drafts, scheduling, publishing, analytics, settings —
// works end-to-end locally against mock data. The service layer sits
// between the UI and the provider:
//
//   UI → BufferService interface → MockBufferService (now)
//                                 → RealBufferService (later, drop-in)
//
// The data model and API surface are built to the real Buffer integration
// shape, so swapping the mock service for the real one later requires no
// schema or route changes — only src/lib/buffer/real-service.ts gets filled
// in and src/lib/buffer/index.ts's selector switches over.

enum SocialPlatform {
  TWITTER
  LINKEDIN
  INSTAGRAM
  FACEBOOK
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

/** A connected (or disconnected) social account — mirrors Buffer "profiles". */
model SocialAccount {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  handle    String
  connected Boolean        @default(true)
  // Mock follower count — populated with a deterministic pseudo-random
  // number on creation, purely for the Analytics tab to have something
  // to show. Replaced by a real follower count once the real API is wired up.
  followers Int            @default(0)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, platform])
  @@map("social_accounts")
}

model SocialPost {
  id           String            @id @default(cuid())
  platform     SocialPlatform
  content      String            @db.Text
  status       SocialPostStatus  @default(DRAFT)
  // Buffer's "update id" once posted through the service layer —
  // lets us look the post back up against the provider.
  providerId   String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  // Mock engagement numbers, populated once a post moves to PUBLISHED.
  // Real API integration replaces these with actual Buffer analytics.
  impressions  Int               @default(0)
  likes        Int               @default(0)
  clicks       Int               @default(0)
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, scheduledFor])
  @@index([userId, status])
  @@map("social_posts")
}

/** Per-user social module preferences. */
model SocialSettings {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultPlatform SocialPlatform @default(TWITTER)
  // If true, posts scheduled through the Hermes agent skip the human
  // approval gate (still "critical" risk by default — this is an opt-in
  // per-user override applied in the tool executor).
  autoPublish   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("social_settings")
}

// ---------------------------------------------------------------------------
// Audit logging (Phase 8)
// ---------------------------------------------------------------------------
// Every agent action and tool call is logged here before execution —
// especially anything gated behind the human-in-the-loop approval flow.

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "meta_ads.increase_budget"
  payload   Json?    // structured details of what was requested / executed
  status    String   // "pending_approval" | "executed" | "rejected" | "failed"
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@map("audit_logs")
}
